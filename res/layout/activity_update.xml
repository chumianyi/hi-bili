<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/bg_dark"
    android:padding="24dip">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/check_update"
        android:textColor="@color/accent_pink"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dip" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dip"
        android:padding="12dip"
        android:background="@color/bg_card">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/current_version"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/tv_current_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dip"
        android:padding="12dip"
        android:background="@color/bg_card">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/latest_version"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/tv_latest_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="@color/accent_pink"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_update_status"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="点击下方按钮检查更新"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="16dip" />

    <Button
        android:id="@+id/btn_check_update"
        android:layout_width="fill_parent"
        android:layout_height="48dip"
        android:text="@string/check_update"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:background="@color/accent_blue"
        android:layout_marginBottom="12dip" />

    <Button
        android:id="@+id/btn_do_update"
        android:layout_width="fill_parent"
        android:layout_height="48dip"
        android:text="@string/update_now"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:background="@color/accent_pink"
        android:visibility="gone" />
</LinearLayout>
